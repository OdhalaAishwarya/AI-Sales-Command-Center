# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=
# Optional: override the model used for analysis.
ANTHROPIC_MODEL=claude-sonnet-5
# Optional, local dev only: uncomment to enable the sidebar's "Ignore cache"
# checkbox, which forces real, billable API calls on already-cached leads.
# Leave unset/false everywhere else - never set this in a deployed
# environment's secrets/config.
# ALLOW_FORCE_REFRESH=true
